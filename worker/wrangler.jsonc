{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janus-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["Registry"]
    }
  ]
}
